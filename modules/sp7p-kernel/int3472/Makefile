KVER ?= $(shell uname -r)
KDIR ?= /usr/src/kernels/$(KVER)

# Local copy of <linux/platform_data/x86/int3472.h> with GPIO_SUPPLY_NAME_LENGTH 6
# (generated by apply.sh); NOSTDINC_FLAGS comes before LINUXINCLUDE, so it wins.
NOSTDINC_FLAGS += -I$(src)/include

obj-m += intel_skl_int3472_discrete.o intel_skl_int3472_common.o
intel_skl_int3472_discrete-y := discrete.o discrete_quirks.o clk_and_regulator.o led.o
intel_skl_int3472_common-y := common.o

all:
	make -C $(KDIR) M=$(PWD) modules

clean:
	make -C $(KDIR) M=$(PWD) clean
