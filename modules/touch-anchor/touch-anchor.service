[Unit]
Description=Virtual touch anchor: keeps the touch capability across suspend (SurfaceTabletKit)
Documentation=https://github.com/sunsetterphoto/SurfaceTabletKit/tree/main/modules/touch-anchor
# Must run before login so GTK apps keep the same touch device from the start.
Before=display-manager.service

[Service]
Type=simple
ExecStart=/usr/local/bin/touch-anchor
Restart=always
RestartSec=1
DevicePolicy=closed
DeviceAllow=/dev/uinput rw
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
