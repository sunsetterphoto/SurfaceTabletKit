# evdev-rce configuration (touch long-press -> right click). Generated by SurfaceTabletKit.
# After editing: sudo systemctl restart evdev-rce

# Hold time in ms until the right click fires. Deliberately LONGER than GTK's own long-press
# time (gtk-long-press-time, 500 ms): GTK apps open their own context menu after 500 ms, and
# an injected right click must not land in that menu.
LONG_CLICK_INTERVAL=1000

# Allowed finger movement while holding, in DEVICE UNITS (not pixels): about 2.7 mm.
LONG_CLICK_FUZZ=@FUZZ@

# Listen only on these devices (exact names, separated by |). Without a whitelist evdev-rce
# would also use the type-cover touchpad and the stylus devices.
TOUCH_DEVICE_WHITELIST=@WHITELIST@

# When the click is sent: 1 = when the finger is lifted (default), 0 = right after the hold time.
# A click injected while the finger is still down is a second, concurrent input sequence;
# GTK gestures set to exclusive (e.g. the desktop icons of gtk4-ding) ignore it.
CLICK_ON_RELEASE=1
